OMEHR_ADMIN_PASSWORD=IlkGirisIcinGuclu!123
OMEHR_TENANT=OMEHR
OMEHR_TENANT_DATA=./tenant_data/OMEHR
OMEHR_PORT=8501
OMEHR_ISOLATED=1
OMEHR_BOOTSTRAP_RUNTIME=1
OMEHR_RUN_ENGINE_ON_START=1
OMEHR_LOG_LEVEL=INFO
OMEHR_SEND_EMAIL=0

# DÜZELTME (SaaS): docker-compose.yml artık PostgreSQL kullanıyor —
# gerçek çok kiracılı kullanım SQLite ile GÜVENLE ölçeklenemez.
# ÜRETİMDE bu şifreyi mutlaka değiştirin, buradaki yalnız örnektir.
POSTGRES_PASSWORD=DEGISTIRIN_GucluBirSifre!2026

# Windows dışındaki e-posta gönderimleri için:
OMEHR_SMTP_HOST=
OMEHR_SMTP_PORT=587
OMEHR_SMTP_TLS=1
OMEHR_SMTP_USER=
OMEHR_SMTP_PASSWORD=
OMEHR_SMTP_FROM=
OMEHR_ALERT_RECIPIENTS=

# Stripe fatura entegrasyonu (bkz. services/multitenant/billing.py,
# webhook_server.py). OMEHR_STRIPE_SECRET_KEY GİZLİDİR — asla commit
# etmeyin/loglamayın. Price ID'leri Stripe Dashboard'da her plan için bir
# ürün/fiyat oluşturunca oradan kopyalayın (deneme planı ücretsizdir, Price
# ID gerektirmez). OMEHR_APP_BASE_URL, Checkout/Portal sonrası kullanıcının
# geri yönlendirileceği uygulamanın herkese açık adresidir (ör. https://app.omehr.com).
OMEHR_STRIPE_SECRET_KEY=
OMEHR_STRIPE_WEBHOOK_SECRET=
OMEHR_STRIPE_PRICE_TEMEL=
OMEHR_STRIPE_PRICE_STANDART=
OMEHR_STRIPE_PRICE_KURUMSAL=
OMEHR_APP_BASE_URL=
# webhook_server.py ayrı bir süreçtir (bkz. Çalıştırma notu orada) — varsayılan port:
OMEHR_WEBHOOK_PORT=8502
